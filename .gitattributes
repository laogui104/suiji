# 统一换行，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# 源码与文档
*.kt        text eol=lf
*.kts       text eol=lf
*.gradle    text eol=lf
*.md        text eol=lf
*.properties text eol=lf
*.xml       text eol=lf
*.py        text eol=lf
*.sh        text eol=lf

# 二进制：不参与换行转换与文本 diff
*.apk       binary
*.zip       binary
*.jar       binary
*.wav       binary
*.png       binary
*.jpg       binary
*.ttf       binary
